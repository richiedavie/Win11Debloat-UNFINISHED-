{
  "registry_policies": [
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "DisableAIDataAnalysis",
      "type": "DWord",
      "value": 1,
      "description": "Disable Recall local AI snapshot indexing data analysis"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "AllowRecallEnablement",
      "type": "DWord",
      "value": 0,
      "description": "Disable Recall enablement on Copilot+ PCs"
    },
    {
      "hive": "HKCU",
      "path": "Software\\Policies\\Microsoft\\Windows\\WindowsCopilot",
      "name": "AllowCopilot",
      "type": "DWord",
      "value": 0,
      "description": "Disable Windows Copilot for current user"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
      "name": "TurnOnWindowsCopilot",
      "type": "DWord",
      "value": 0,
      "description": "Disable Windows Copilot system-wide"
    },
    {
      "hive": "HKCU",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "ShowCopilotButton",
      "type": "DWord",
      "value": 0,
      "description": "Hide Copilot taskbar button"
    },
    {
      "hive": "HKCU",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "DITPrevalence",
      "type": "DWord",
      "value": 0,
      "description": "Disable Click to Do / Design Intelligent Text experience"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "AllowAllUsersAllDeviceAIFeatures",
      "type": "DWord",
      "value": 0,
      "description": "Disable AI features for all users across all devices"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "DisableGPTForEdge",
      "type": "DWord",
      "value": 1,
      "description": "Disable GPT AI integration in Microsoft Edge"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "DisableAISuggestionsInFileExplorer",
      "type": "DWord",
      "value": 1,
      "description": "Disable AI-generated search suggestions in File Explorer"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "DisableEdgeAICore",
      "type": "DWord",
      "value": 1,
      "description": "Disable Edge browser AI core features and Copilot sidebar"
    },
    {
      "hive": "HKCU",
      "path": "Software\\Policies\\Microsoft\\Edge",
      "name": "CopilotEnabled",
      "type": "DWord",
      "value": 0,
      "description": "Disable Edge Copilot sidebar in browser"
    },
    {
      "hive": "HKCU",
      "path": "Software\\Policies\\Microsoft\\Edge",
      "name": "DhmaPreference",
      "type": "DWord",
      "value": 0,
      "description": "Disable Edge Dynamic Hyperlink Matching and AITelemetry"
    },
    {
      "hive": "HKCU",
      "path": "Software\\Policies\\Microsoft\\Edge",
      "name": "UserDataDefault",
      "type": "String",
      "value": "Default",
      "description": "Ensure Edge uses default clean profile without AI features"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Edge",
      "name": "UserFeedbackAllowed",
      "type": "DWord",
      "value": 0,
      "description": "Disable Edge automatic user feedback collection"
    },
    {
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Edge",
      "name": "MetricsReportingEnabled",
      "type": "DWord",
      "value": 0,
      "description": "Disable Edge diagnostic data and metrics reporting"
    }
  ],
  "services": [
    {
      "name": "WSAIFabricSvc",
      "displayName": "Windows AI Fabric Service",
      "action": "Disable"
    },
    {
      "name": "OneDrive",
      "displayName": "Microsoft OneDrive (Optional AI sync)",
      "action": "Disable"
    },
    {
      "name": "EdgeUpdate",
      "displayName": "Microsoft Edge Update Service",
      "action": "Disable"
    },
    {
      "name": "LexmarkService",
      "displayName": "Lexmark Service (if present)",
      "action": "Disable"
    },
    {
      "name": "AssignedAccessManager",
      "displayName": "Assigned Access Manager",
      "action": "Disable"
    },
    {
      "name": "XblAuthManager",
      "displayName": "Xbox Live Auth Manager",
      "action": "Disable"
    },
    {
      "name": "XblGameSave",
      "displayName": "Xbox Live Game Save",
      "action": "Disable"
    },
    {
      "name": "XboxNetApiSvc",
      "displayName": "Xbox Live Networking Service",
      "action": "Disable"
    }
  ],
